APP_DATA_DIR=./data
DEFAULT_PIPELINE=local

ISAAC_SIM_PATH=/home/sidg/isaacsim

# =============================================================================
# PASTE KEYS HERE (copy this file to .env first:  cp .env.example .env)
# =============================================================================

# Required for Marble showcase pipeline — https://platform.worldlabs.ai/api-keys
# Buy API credits at https://platform.worldlabs.ai/billing (NOT the Marble web app)
MARBLE_API_KEY=
MARBLE_BASE_URL=https://api.worldlabs.ai
MARBLE_CREDIT_BUDGET=5000
MARBLE_DRAFT_MODEL=marble-1.0-draft
MARBLE_FULL_MODEL=marble-1.1
MARBLE_PLUS_MODEL=marble-1.1-plus
# One-shot loop: PromptSmith → Critic → single generate (plus) → full_res export
MARBLE_DRAFT_COUNT=1
MARBLE_POLL_INTERVAL_S=5
MARBLE_POLL_TIMEOUT_S=900

# Optional — better PromptSmith / Critic via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional local VLM (SemanticTagger / draft scorer)
VLM_BASE_URL=http://localhost:8000/v1
VLM_MODEL=qwen3-vl
